{
  "name": "sharing-circle",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "test -f .dev.vars || cp .dev.vars.example .dev.vars; npm run build && wrangler d1 migrations apply DB --local && wrangler dev --port 8787",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p worker && tsc --noEmit -p web",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "backup": "scripts/backup.sh"
  },
  "dependencies": {
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
